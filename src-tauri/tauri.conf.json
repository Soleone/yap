{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yap",
  "mainBinaryName": "yap-app",
  "version": "../package.json",
  "identifier": "com.soleone.yap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yap",
        "width": 720,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
